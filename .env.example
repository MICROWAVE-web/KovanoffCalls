# Telegram bot
BOT_TOKEN=123456:replace-with-your-bot-token

# Public HTTPS URL of the frontend (used by bot WebApp button)
WEBAPP_URL=https://example.ngrok.app

# Backend
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXP_DAYS=7
PRESENCE_TTL_SECONDS=60
RING_TIMEOUT_SECONDS=30
ALLOWED_ORIGINS=https://example.ngrok.app,http://localhost:5173

# Postgres
POSTGRES_USER=kovanoff
POSTGRES_PASSWORD=kovanoff
POSTGRES_DB=kovanoff
DATABASE_URL=postgresql+asyncpg://kovanoff:kovanoff@postgres:5432/kovanoff

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend (consumed by Vite at build/dev time)
VITE_API_BASE_URL=https://example.ngrok.app/api
VITE_WS_BASE_URL=wss://example.ngrok.app/api
