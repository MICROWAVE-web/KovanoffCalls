# Telegram bot
BOT_TOKEN=123456:replace-with-your-bot-token

# Public HTTPS URL (домен, на который смотрит твой сервер)
WEBAPP_URL=https://kovanoffcalls.maptap.ru

# Backend
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXP_DAYS=7
PRESENCE_TTL_SECONDS=60
RING_TIMEOUT_SECONDS=30
ALLOWED_ORIGINS=https://kovanoffcalls.maptap.ru

# Postgres
POSTGRES_USER=kovanoff
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=kovanoff
DATABASE_URL=postgresql+asyncpg://kovanoff:replace-with-strong-password@postgres:5432/kovanoff

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend (читается Vite на старте)
VITE_API_BASE_URL=https://kovanoffcalls.maptap.ru/api
VITE_WS_BASE_URL=wss://kovanoffcalls.maptap.ru/api
